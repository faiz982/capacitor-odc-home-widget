<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Merged into the host app at build time; no ODC build action needed. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <receiver
            android:name="com.odchomewidget.CustomWidgetProvider"
            android:exported="false"
            android:label="@string/odc_widget_custom_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odc_widget_custom_info" />
        </receiver>
    </application>
</manifest>
