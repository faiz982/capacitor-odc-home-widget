<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Merged into the host app at build time; no ODC build action needed. -->
    <application>
        <receiver
            android:name="com.odchomewidget.CountWidgetProvider"
            android:exported="false"
            android:label="@string/odc_widget_count_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odc_widget_count_info" />
        </receiver>

        <receiver
            android:name="com.odchomewidget.ListWidgetProvider"
            android:exported="false"
            android:label="@string/odc_widget_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odc_widget_list_info" />
        </receiver>

        <receiver
            android:name="com.odchomewidget.ActionsWidgetProvider"
            android:exported="false"
            android:label="@string/odc_widget_actions_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/odc_widget_actions_info" />
        </receiver>
    </application>
</manifest>
