<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/odc_w_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/odc_w_header_icon_wrap"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/odc_w_header_icon_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/odc_w_shape_circle" />

        <ImageView
            android:id="@+id/odc_w_header_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/odc_w_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/odc_w_header_btn1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:padding="1dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/odc_w_header_btn2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:padding="1dp"
        android:visibility="gone" />
</LinearLayout>
