<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: only FrameLayout, LinearLayout, TextView, ImageView, ProgressBar, ListView and GridView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/odc_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/odc_w_shape_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/odc_w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/odc_w_shape_card" />

    <TextView
        android:id="@+id/odc_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/odc_widget_empty"
        android:textColor="@color/odc_w_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/odc_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <include layout="@layout/odc_w_header" />
        <TextView
            android:id="@+id/odc_w_none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp"
            android:text="@string/odc_widget_list_none"
            android:visibility="gone" />
        <TextView
            android:id="@+id/odc_w_row1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
        <TextView
            android:id="@+id/odc_w_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
        <TextView
            android:id="@+id/odc_w_row3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>
</FrameLayout>
