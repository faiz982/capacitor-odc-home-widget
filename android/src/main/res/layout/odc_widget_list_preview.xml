<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: only LinearLayout / TextView / ImageView are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/odc_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/odc_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/odc_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/odc_widget_empty"
        android:textColor="@color/odc_widget_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/odc_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/odc_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="My tasks"
            android:textColor="@color/odc_widget_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/odc_widget_list_none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/odc_widget_list_none"
            android:textColor="@color/odc_widget_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/odc_widget_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Purchase order #4512"
            android:textColor="@color/odc_widget_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/odc_widget_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Leave request: J. Smith"
            android:textColor="@color/odc_widget_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/odc_widget_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Invoice INV-0098"
            android:textColor="@color/odc_widget_text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
