{
  "name": "capacitor-odc-home-widget",
  "version": "0.3.0",
  "description": "Android home screen widgets for OutSystems ODC apps",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "CapacitorOdcHomeWidget.podspec"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faiz982/capacitor-odc-home-widget.git"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "outsystems",
    "odc",
    "widget",
    "android"
  ],
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
